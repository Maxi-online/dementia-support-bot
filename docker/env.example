# Docker-only environment variables
# Application configuration lives in settings.json

# Database (for docker-compose)
POSTGRES_PASSWORD=your_secure_postgres_password

# Optional: SSL settings (for nginx)
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_PRIVATE_KEY_PATH=/etc/nginx/ssl/private.key

# ALL OTHER SETTINGS ARE IN settings.json:
# - Telegram bot token
# - OpenAI API key
# - Application settings
# - Service URLs
# - Security settings
# - Logging configuration
