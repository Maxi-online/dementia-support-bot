# Настройки Telegram бота
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Настройки OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Настройки Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_HOST=https://dementia-5516f5b.svc.aped-4627-b74a.pinecone.io
PINECONE_INDEX_NAME=dementia

# Настройки базы данных
DATABASE_URL=postgresql://user:password@localhost:5432/dementia_bot

# Настройки логирования
LOG_LEVEL=INFO

# Настройки базы знаний
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Настройки пользовательских данных
MAX_HISTORY_ENTRIES=100
MAX_EMERGENCY_CONTACTS=5

# Настройки агентов
MAX_CONVERSATION_HISTORY=10

# Knowledge base settings
MAX_SEARCH_RESULTS=5 